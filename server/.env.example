# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL - Supabase / Neon / Render / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d

# AI API Key (Google Gemini) - MUST REMAIN ON BACKEND ONLY
AI_API_KEY=your_gemini_api_key_here
